# Formspree form ID — sign up free at https://formspree.io
# Create a form → copy the form ID (looks like: xpwzabcd)
NEXT_PUBLIC_FORMSPREE_ID=your_formspree_form_id

# Google Apps Script Web App URL — applications also get appended to a shared Google Sheet for admins
# See README "Google Sheet Setup" section
NEXT_PUBLIC_SHEETS_WEBHOOK_URL=your_apps_script_web_app_url

# Anthropic API key — only needed if you run: npm run generate-data
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key
